    a(2024, 1, 'QCM', 'Quand la cathédrale Notre-Dame de Paris a-t-elle rouvert après l\'incendie de 2019 ?', 'En décembre 2024', 'En avril 2024', 'En juillet 2025', 'Elle n\'a pas encore rouvert',
