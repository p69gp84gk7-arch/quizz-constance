    // ---------------- 2024 ----------------
    a(2024, 1, 'QCM', 'Où a été allumée la vasque olympique des Jeux de Paris 2024 ?', 'Dans le jardin des Tuileries, sous un ballon', 'Au sommet de la tour Eiffel', 'Au Stade de France', 'Sur le parvis de Notre-Dame',
